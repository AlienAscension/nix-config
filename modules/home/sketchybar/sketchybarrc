#!/usr/bin/env bash
# SketchyBar — floating bar at the top.
# Inspired by https://github.com/omerxx/dotfiles and
# https://github.com/dtran421/dotfiles (NerdFont icons, widget groups).

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"

ITEM_DIR="$CONFIG_DIR/items"
PLUGIN_DIR="$CONFIG_DIR/plugins"

FONT="JetBrainsMono Nerd Font"
ICON_FONT="$FONT:Bold:15.0"
LABEL_FONT="$FONT:Medium:13.0"
APP_FONT="sketchybar-app-font:Regular:16.0"
PADDINGS=4

sketchybar --bar height=38 \
                 position=top \
                 y_offset=6 \
                 margin=6 \
                 corner_radius=10 \
                 color=$BAR_COLOR \
                 blur_radius=20 \
                 shadow=on \
                 padding_left=6 \
                 padding_right=6 \
           --default updates=when_shown \
                 icon.font="$ICON_FONT" \
                 icon.color=$ICON_COLOR \
                 icon.padding_left=$PADDINGS \
                 icon.padding_right=$PADDINGS \
                 label.font="$LABEL_FONT" \
                 label.color=$LABEL_COLOR \
                 label.padding_left=$PADDINGS \
                 label.padding_right=$PADDINGS \
                 background.height=26 \
                 background.corner_radius=8 \
                 background.drawing=off \
                 background.color=$BG1 \
                 background.border_width=1 \
                 background.border_color=$BG2 \
                 background.padding_left=2 \
                 background.padding_right=2 \
                 popup.background.border_width=2 \
                 popup.background.corner_radius=10 \
                 popup.background.border_color=$POPUP_BORDER_COLOR \
                 popup.background.color=$POPUP_BACKGROUND_COLOR \
                 popup.blur_radius=30

# Left: Apple menu, AeroSpace workspaces, mode indicator
source "$ITEM_DIR/apple.sh"
source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/mode.sh"

# Center: focused application
source "$ITEM_DIR/front_app.sh"

# Right: wifi, volume, battery, clock
source "$ITEM_DIR/wifi.sh"
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/clock.sh"

# Group the right-side status items into a single rounded pill
sketchybar --add bracket status wifi volume battery clock \
           --set status background.drawing=on \
                        background.color=$BG1 \
                        background.border_color=$BG2 \
                        background.border_width=1 \
                        background.corner_radius=8 \
                        background.height=26

sketchybar --update
